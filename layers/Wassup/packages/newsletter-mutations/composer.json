{
    "name": "pop-sites-wassup/newsletter-mutations",
    "type": "library",
    "description": "Adds mutations for newsletter functionality",
    "keywords": ["Gato", "GatoGraphQL", "GraphQL", "PHP", "newsletter-mutations"],
    "homepage": "https://github.com/PoPSites-Wassup/newsletter-mutations",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Leonardo Losoviz",
            "email": "leo@getpop.org",
            "homepage": "https://gatographql.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "pop-sites-wassup/form-mutations": "^1.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^10.2",
        "rector/rector": "^1.2",
        "squizlabs/php_codesniffer": "^3.6"
    },
    "autoload": {
        "psr-4": {
            "PoPSitesWassup\\NewsletterMutations\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PoPSitesWassup\\NewsletterMutations\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "check-style": "phpcs src tests",
        "fix-style": "phpcbf src tests",
        "analyse": "phpstan analyse"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-master": "1.1-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
